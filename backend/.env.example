# ==============================================================================
# HealthBridge AI - Backend Environment Configuration
# ==============================================================================

# AI Model Provider Configuration
# Choose one of the following providers: 'gemini' (recommended), 'groq', or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq API Key (Optional alternative - Free high-speed tier at https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Safety & Verification Settings
STRICT_NUMERIC_VERIFICATION=true
MINIMUM_VERIFICATION_THRESHOLD=70
